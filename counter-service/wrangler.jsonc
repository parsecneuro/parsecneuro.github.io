{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "parsec-tool-counter",
	"main": "worker.mjs",
	"compatibility_date": "2026-09-11",
	"workers_dev": true,
	"preview_urls": false,
	"send_metrics": false,
	"logpush": false,
	"observability": {
		"enabled": false
	},
	"vars": {
		"ALLOWED_ORIGINS": "https://parsecneuro.github.io"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "parsec-tool-counter",
			"database_id": "b1250bde-5aa7-4d90-b84c-c2f15c1177e1"
		},
		{
			"binding": "parsec_tool_counter",
			"database_name": "parsec-tool-counter",
			"database_id": "b1250bde-5aa7-4d90-b84c-c2f15c1177e1",
			"remote": true
		}
	],
	"triggers": {
		"crons": [
			"17 3 * * *"
		]
	}
}